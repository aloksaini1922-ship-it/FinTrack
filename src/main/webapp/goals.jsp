<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;} List<Map<String,Object>> goals=(List<Map<String,Object>>)request.getAttribute("goals"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Savings goals · FinTrack</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="assets/css/style.css" rel="stylesheet"></head><body class="app-bg"><nav class="navbar app-nav"><div class="container"><a class="brand" href="dashboard"><span class="brand-mark">F</span> FinTrack</a><div class="d-flex gap-3"><a href="dashboard">Dashboard</a><a href="budgets">Budgets</a></div></div></nav><main class="container py-5"><h1 class="page-title">Savings goals</h1><p class="muted mb-4">Make room for what matters.</p><div class="row g-4"><div class="col-md-5"><section class="panel"><h2 class="section-title mb-3">Create a goal</h2><form method="post" action="goals"><input type="hidden" name="action" value="save"><label class="form-label">Goal name</label><input class="form-control" name="title" maxlength="120" placeholder="e.g. New laptop" required><label class="form-label mt-3">Target amount (₹)</label><input class="form-control" name="target" type="number" min=".01" step=".01" required><label class="form-label mt-3">Already saved (₹)</label><input class="form-control" name="saved" type="number" min="0" step=".01" value="0" required><label class="form-label mt-3">Target date (optional)</label><input class="form-control" name="targetDate" type="date"><button class="btn btn-fin w-100 mt-4">Create goal</button></form></section></div><div class="col-md-7"><div class="row g-3"><% if(goals==null||goals.isEmpty()){ %><div class="col-12"><section class="panel muted">No goals yet. Create your first savings goal.</section></div><% }else{for(Map<String,Object>g:goals){java.math.BigDecimal target=(java.math.BigDecimal)g.get("target"),saved=(java.math.BigDecimal)g.get("saved");int pct=target.signum()==0?0:Math.min(100,saved.multiply(new java.math.BigDecimal(100)).divide(target,0,java.math.RoundingMode.HALF_UP).intValue());%><div class="col-12"><section class="panel"><div class="d-flex justify-content-between gap-2"><div><h2 class="section-title"><%=String.valueOf(g.get("title")).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")%></h2><p class="muted small mb-3">Target date: <%=g.get("date")==null?"Not set":g.get("date")%></p></div><form method="post" action="goals" onsubmit="return confirm('Delete this goal?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=g.get("id")%>"><button class="btn btn-outline-fin btn-sm">Delete</button></form></div><div class="d-flex justify-content-between small mb-2"><span>₹<%=saved%> saved</span><span>₹<%=target%> target · <%=pct%>%</span></div><div class="progress" style="height:8px"><div class="progress-bar bg-success" style="width:<%=pct%>%"></div></div></section></div><%}}%></div></div></div></main></body></html>