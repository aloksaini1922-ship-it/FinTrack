<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><% if(session.getAttribute("userId")==null){response.sendRedirect("login.jsp");return;} List<Map<String,Object>> budgets=(List<Map<String,Object>>)request.getAttribute("budgets"); %>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Budgets · FinTrack</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="assets/css/style.css" rel="stylesheet"></head><body class="app-bg"><nav class="navbar app-nav"><div class="container"><a class="brand" href="dashboard"><span class="brand-mark">F</span> FinTrack</a><div class="d-flex gap-3"><a href="dashboard">Dashboard</a><a href="goals">Savings goals</a></div></div></nav><main class="container py-5"><h1 class="page-title">Monthly budgets</h1><p class="muted mb-4">Set spending limits by category.</p><div class="row g-4"><div class="col-md-5"><section class="panel"><h2 class="section-title mb-3">Set a budget</h2><form method="post" action="budgets"><label class="form-label">Category</label><select name="category" class="form-select"><option>Food</option><option>Transport</option><option>Housing</option><option>Shopping</option><option>Education</option><option>Health</option><option>Entertainment</option><option>Utilities</option><option>Other</option></select><label class="form-label mt-3">Monthly limit (₹)</label><input class="form-control" type="number" min=".01" step=".01" name="limit" required><label class="form-label mt-3">Month</label><input class="form-control" type="month" name="month" value="<%= java.time.YearMonth.now() %>" required><button class="btn btn-fin w-100 mt-4">Save budget</button></form></section></div><div class="col-md-7"><section class="panel"><h2 class="section-title mb-3">Your budgets</h2><div class="table-responsive"><table class="table"><thead><tr><th>Category</th><th>Month</th><th>Limit</th><th>Spent</th></tr></thead><tbody><% if(budgets==null||budgets.isEmpty()){ %><tr><td colspan="4" class="muted">No budgets yet.</td></tr><% }else{for(Map<String,Object>b:budgets){java.math.BigDecimal lim=(java.math.BigDecimal)b.get("limit"),sp=(java.math.BigDecimal)b.get("spent");int pct=lim.signum()==0?0:Math.min(100,sp.multiply(new java.math.BigDecimal(100)).divide(lim,0,java.math.RoundingMode.HALF_UP).intValue());%><tr><td><%= b.get("category") %><div class="progress mt-2" style="height:5px"><div class="progress-bar <%= pct>=100?"bg-danger":"bg-success" %>" style="width:<%=pct%>%"></div></div></td><td><%=b.get("month")%></td><td>₹<%=lim%></td><td>₹<%=sp%></td></tr><%}}%></tbody></table></div></section></div></div></main></body></html>