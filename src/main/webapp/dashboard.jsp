<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.*,java.math.BigDecimal" %>
<%
if (session.getAttribute("userId") == null) { response.sendRedirect("login.jsp"); return; }
String userName=(String)session.getAttribute("userName");
BigDecimal income=(BigDecimal)request.getAttribute("income"), expenses=(BigDecimal)request.getAttribute("expenses"), balance=(BigDecimal)request.getAttribute("balance");
List<Map<String,Object>> transactions=(List<Map<String,Object>>)request.getAttribute("transactions");
%>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Overview · FinTrack</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="assets/css/style.css"><script src="https://cdn.jsdelivr.net/npm/chart.js"></script></head><body class="app-bg"><nav class="navbar navbar-expand-lg app-nav"><div class="container-fluid px-lg-5"><a class="brand" href="dashboard"><span class="brand-mark">F</span> FinTrack</a><div class="d-flex align-items-center gap-3"><span class="muted small">Hi, <%= userName == null ? "there" : userName.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;") %></span><form method="post" action="logout"><button class="btn btn-outline-fin btn-sm">Sign out</button></form></div></div></nav>
<main class="container-fluid px-lg-5 py-4 py-lg-5"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="eyebrow">PERSONAL FINANCE</p><h1 class="page-title">Your overview.</h1><p class="muted mb-0">A clearer view of where your money goes.</p></div><span class="date-pill"><%= java.time.LocalDate.now() %></span></div>
<div class="row g-3 mb-4"><div class="col-12 col-md-4"><div class="metric-card"><span class="metric-label">Total income</span><div class="metric-value">₹<%= income %></div><span class="metric-note">All recorded income</span></div></div><div class="col-12 col-md-4"><div class="metric-card"><span class="metric-label">Total expenses</span><div class="metric-value">₹<%= expenses %></div><span class="metric-note">All recorded expenses</span></div></div><div class="col-12 col-md-4"><div class="metric-card metric-primary"><span class="metric-label">Net balance</span><div class="metric-value">₹<%= balance %></div><span class="metric-note">Income minus expenses</span></div></div></div>
<div class="row g-4"><div class="col-12 col-xl-8"><section class="panel h-100"><div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="section-title">Transactions</h2><p class="muted small mb-0">Your latest 100 entries</p></div></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Details</th><th>Date</th><th>Type</th><th class="text-end">Amount</th></tr></thead><tbody>
<% if (transactions == null || transactions.isEmpty()) { %><tr><td colspan="4" class="text-center py-5 muted">No transactions yet. Add your first one.</td></tr><% } else { for (Map<String,Object> t : transactions) { String typ=(String)t.get("type"); String desc=String.valueOf(t.get("description")).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;"); String cat=String.valueOf(t.get("category")).replace("&","&amp;").replace("<","&lt;").replace(">","&gt;"); %><tr><td><div class="fw-semibold"><%= desc %></div><div class="muted small"><%= cat %></div></td><td class="small"><%= t.get("date") %></td><td><span class="type-pill <%= "INCOME".equals(typ)?"type-income":"type-expense" %>"><%= typ %></span></td><td class="text-end fw-semibold <%= "INCOME".equals(typ)?"text-success":"text-danger" %>"><%= "INCOME".equals(typ)?"+":"−" %>₹<%= t.get("amount") %></td></tr><% } } %>
</tbody></table></div></section></div><div class="col-12 col-xl-4"><section class="panel"><h2 class="section-title">Add a transaction</h2><p class="muted small">Record income or an expense.</p><form method="post" action="dashboard"><label class="form-label">Transaction type</label><select class="form-select" name="type" required><option value="EXPENSE">Expense</option><option value="INCOME">Income</option></select><label class="form-label mt-3">Description</label><input class="form-control" name="description" required maxlength="255" placeholder="e.g. Monthly groceries"><label class="form-label mt-3">Category</label><select class="form-select" name="category" required><option>Food</option><option>Transport</option><option>Housing</option><option>Salary</option><option>Education</option><option>Shopping</option><option>Health</option><option>Entertainment</option><option>Utilities</option><option>Other</option></select><label class="form-label mt-3">Amount (₹)</label><input class="form-control" type="number" name="amount" min="0.01" step="0.01" required placeholder="0.00"><label class="form-label mt-3">Date</label><input class="form-control" type="date" name="transactionDate" value="<%= java.time.LocalDate.now() %>" required><button class="btn btn-fin w-100 mt-4">Save transaction →</button></form></section><section class="panel mt-4"><h2 class="section-title">Income vs expenses</h2><canvas id="moneyChart" aria-label="Income versus expenses chart"></canvas></section></div></div><footer class="footer-note mt-5">FinTrack Trio · Galgotias University · B.Tech CSE</footer></main>
<script>new Chart(document.getElementById('moneyChart'),{type:'doughnut',data:{labels:['Income','Expenses'],datasets:[{data:[<%= income %>,<%= expenses %>],backgroundColor:['#176b4d','#d7a56d'],borderWidth:0,hoverOffset:5}]},options:{cutout:'72%',plugins:{legend:{position:'bottom'}}}});</script></body></html>